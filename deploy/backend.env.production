# /var/www/portfolio-backend/.env  (production)
# Fill DB_PASSWORD from the 01-server-setup.sh output, then run:
#   php artisan key:generate
# NEVER commit this file.

APP_NAME="Sobirjon SWE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.sobirjonswe.uz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=CHANGE_ME_FROM_SETUP_SCRIPT_OUTPUT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sobirjonswe.uz
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sobirjonswe.uz"
MAIL_FROM_NAME="${APP_NAME}"

# CORS: exact origins the browser may call this API from (config/cors.php).
FRONTEND_URLS=https://sobirjonswe.uz,https://www.sobirjonswe.uz

# Sanctum: hosts whose requests count as "first-party" (stateful cookie auth).
SANCTUM_STATEFUL_DOMAINS=sobirjonswe.uz,www.sobirjonswe.uz

# Public LeetCode username proxied by LeetCodeController.
LEETCODE_USERNAME=Sobirjon-swe

# Private Telegram chat that gets "new enquiry / new comment" alerts.
# Token from @BotFather; chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# after sending the bot one message. Blank = notifications off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Days of visitor analytics to keep; page-views:prune deletes anything older.
ANALYTICS_RETENTION_DAYS=180
